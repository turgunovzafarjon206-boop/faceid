# ====== TELEGRAM ======
# @BotFather dan olingan token (avval /revoke qilib YANGISINI oling!)
BOT_TOKEN=BU_YERGA_YANGI_TOKEN

# Admin Telegram ID (bir nechta bo'lsa vergul bilan: 8147049470,123456789)
ADMIN_IDS=8147049470

# ====== FACEID QURILMA ======
# Rejim: mock | generic | hikvision
#   mock      -> qurilmasiz test (hech narsa o'qimaydi)
#   generic   -> oddiy JSON API
#   hikvision -> Hikvision ISAPI
FACEID_MODE=mock

# Qurilma / API manzili
FACEID_API_URL=http://192.168.1.64
FACEID_API_TOKEN=
FACEID_API_USER=admin
FACEID_API_PASS=parol

# Qurilmani necha soniyada bir tekshirish
FACEID_POLL_INTERVAL=15

# ====== ISH GRAFIGI (standart) ======
DEFAULT_WORK_START=08:00
DEFAULT_WORK_END=18:00
GRACE_MINUTES=0

# Kunlik hisobot yuborish vaqti (HH:MM)
DAILY_REPORT_TIME=23:30

# ====== BOSHQA ======
TZ=Asia/Tashkent
DB_PATH=faceid_bot.db
